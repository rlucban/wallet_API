        {
          "name": "register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const jsonData = pm.response.json();\n",
                  "if (jsonData && jsonData.data && jsonData.data.token) {\n",
                  "    pm.collectionVariables.set(\"token\", jsonData.data.token);\n",
                  "}\n",
                  "if (jsonData && jsonData.data && jsonData.data.user && jsonData.data.user.id) {\n",
                  "    pm.collectionVariables.set(\"userId\", jsonData.data.user.id);\n",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"testuser\",\n  \"passcode\": \"1234\",\n  \"initialBalance\": 1000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            }
          },
